---
import BaseLayout from '../layouts/BaseLayout.astro';
import AeroWindow from '../components/AeroWindow.astro';
import { timeline } from '../data/timeline';

const description = 'A sourced timeline of the glossy interface era, from Aqua in 2000 to the Frutiger Aero nickname in 2017 and the archives that followed.';
---

<BaseLayout title="Timeline" description={description} image="art/scene-glass.svg">
  <AeroWindow title="From Aqua to the nickname">
    <p>The pictures people now file under Frutiger Aero were not born with that label. This line runs from the first gel Macintosh chrome to the museum shelves of the 2020s. Open a year for the note and the source. Dates that were easy to pin down are written as dates. Ranges stay ranges.</p>
    <div class="timeline">
      {timeline.map((entry, index) => (
        <details class="entry" open={index < 3}>
          <summary>
            <span class="year-mark">{entry.year}</span>
            {entry.title}
            <small> · {entry.dateLabel}</small>
          </summary>
          <div class="entry-body">
            <p>{entry.body}</p>
            <p>Source: <a href={entry.url}>{entry.source}</a></p>
          </div>
        </details>
      ))}
    </div>
  </AeroWindow>
</BaseLayout>
