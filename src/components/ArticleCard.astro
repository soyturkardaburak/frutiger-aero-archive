---
import { asset } from '../lib/paths';
interface Props {
  href: string;
  title: string;
  summary: string;
  image: string;
  imageAlt: string;
  meta?: string;
}
const { href, title, summary, image, imageAlt, meta } = Astro.props;
---
<a class="article-card" href={href}>
  <img src={asset(image)} alt={imageAlt} width="360" height="110" loading="lazy" />
  <div>
    {meta && <small>{meta}</small>}
    <strong>{title}</strong>
    <small>{summary}</small>
  </div>
</a>
